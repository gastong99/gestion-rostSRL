<div class="row">

    <div class="col-md-4 mb-3">
        <label for="Code" class="form-label">Código *</label>
        <input name="Code"
               id="Code"
               class="form-control"
               maxlength="20"
               required />
    </div>

    <div class="col-md-8 mb-3">
        <label for="BusinessName" class="form-label">Razón Social *</label>
        <input name="BusinessName"
               id="BusinessName"
               class="form-control"
               maxlength="150"
               required />
    </div>

    <div class="col-md-6 mb-3">
        <label for="FantasyName" class="form-label">Nombre Comercial</label>
        <input name="FantasyName"
               id="FantasyName"
               class="form-control"
               maxlength="150" />
    </div>

    <div class="col-md-6 mb-3">
        <label for="TaxId" class="form-label">CUIT / RUT / NIT</label>
        <input name="TaxId"
               id="TaxId"
               class="form-control"
               maxlength="20" />
    </div>

    <div class="col-md-6 mb-3">
        <label for="Email" class="form-label">Email</label>
        <input name="Email"
               id="Email"
               type="email"
               class="form-control"
               maxlength="150" />
    </div>

    <div class="col-md-6 mb-3">
        <label for="Phone" class="form-label">Teléfono</label>
        <input name="Phone"
               id="Phone"
               class="form-control"
               maxlength="50" />
    </div>

    <div class="col-md-12 mb-3">
        <label for="Address" class="form-label">Dirección</label>
        <input name="Address"
               id="Address"
               class="form-control"
               maxlength="200" />
    </div>

    <div class="col-md-4 mb-3">
        <label for="City" class="form-label">Ciudad</label>
        <input name="City"
               id="City"
               class="form-control"
               maxlength="100" />
    </div>

    <div class="col-md-4 mb-3">
        <label for="Province" class="form-label">Provincia</label>
        <input name="Province"
               id="Province"
               class="form-control"
               maxlength="100" />
    </div>

    <div class="col-md-4 mb-3">
        <label for="Country" class="form-label">País</label>
        <input name="Country"
               id="Country"
               class="form-control"
               maxlength="100"
               value="Argentina" />
    </div>

    <div class="col-md-12 mb-3">
        <label for="Notes" class="form-label">Observaciones</label>

        <textarea name="Notes"
                  id="Notes"
                  class="form-control"
                  rows="4"
                  maxlength="500"></textarea>
    </div>

</div>