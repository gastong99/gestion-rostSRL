<div class="dashboard-section">

    <div class="section-title">
        Catálogos
    </div>

    <div class="dashboard-grid-section grid-two-cols">

        <a asp-controller="Categories" asp-action="Index" class="dashboard-card text-decoration-none">
            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-tags dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title">
                    Categorías
                </h4>

                <p class="dashboard-card-desc">
                    Gestionar categorías de items y servicios
                </p>
            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>

        <a asp-controller="Items" asp-action="Index" class="dashboard-card text-decoration-none">
            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-box-seam dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title">
                    Items
                </h4>

                <p class="dashboard-card-desc">
                    Gestionar productos, materiales y servicios
                </p>
            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>
    </div>
</div>