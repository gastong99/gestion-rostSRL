<div class="dashboard-section">

    <div class="section-title">
        Inventario
    </div>

    <div class="dashboard-grid-section grid-two-cols">

        <a asp-controller="Warehouses" asp-action="Index" class="dashboard-card text-decoration-none">
            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-buildings dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title">
                    Depósitos
                </h4>

                <p class="dashboard-card-desc">
                    Gestionar depósitos y almacenes
                </p>

            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>

        <a asp-controller="Stocks" asp-action="Index" class="dashboard-card text-decoration-none">
            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-boxes dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">

                <h4 class="dashboard-card-title">
                    Stock
                </h4>

                <p class="dashboard-card-desc">
                    Consultar y ajustar existencias por depósito
                </p>

            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>

        <a asp-controller="StockMovements" asp-action="Index" class="dashboard-card text-decoration-none">
            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-arrow-left-right dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">

                <h4 class="dashboard-card-title">
                    Movimientos
                </h4>

                <p class="dashboard-card-desc">
                    Consultar ingresos, egresos y ajustes de inventario
                </p>

            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>
    </div>
</div>