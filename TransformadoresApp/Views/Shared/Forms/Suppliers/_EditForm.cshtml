<div class="row g-3">

    <input type="hidden"
           id="edit_Id"
           name="Id" />

    <div class="col-md-4">
        <label for="edit_Code" class="form-label">
            Código <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="edit_Code"
               name="Code"
               class="form-control"
               maxlength="20"
               required />
    </div>

    <div class="col-md-8">
        <label for="edit_BusinessName" class="form-label">
            Razón Social <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="edit_BusinessName"
               name="BusinessName"
               class="form-control"
               maxlength="150"
               required />
    </div>

    <div class="col-md-6">
        <label for="edit_FantasyName" class="form-label">
            Nombre Comercial
        </label>

        <input type="text"
               id="edit_FantasyName"
               name="FantasyName"
               class="form-control"
               maxlength="150" />
    </div>

    <div class="col-md-6">
        <label for="edit_TaxId" class="form-label">
            CUIT / RUT / NIT
        </label>

        <input type="text"
               id="edit_TaxId"
               name="TaxId"
               class="form-control"
               maxlength="20" />
    </div>

    <div class="col-md-6">
        <label for="edit_Email" class="form-label">
            Email
        </label>

        <input type="email"
               id="edit_Email"
               name="Email"
               class="form-control"
               maxlength="150" />
    </div>

    <div class="col-md-6">
        <label for="edit_Phone" class="form-label">
            Teléfono
        </label>

        <input type="text"
               id="edit_Phone"
               name="Phone"
               class="form-control"
               maxlength="50" />
    </div>

    <div class="col-12">
        <label for="edit_Address" class="form-label">
            Dirección
        </label>

        <input type="text"
               id="edit_Address"
               name="Address"
               class="form-control"
               maxlength="200" />
    </div>

    <div class="col-md-4">
        <label for="edit_City" class="form-label">
            Ciudad
        </label>

        <input type="text"
               id="edit_City"
               name="City"
               class="form-control"
               maxlength="100" />
    </div>

    <div class="col-md-4">
        <label for="edit_Province" class="form-label">
            Provincia
        </label>

        <input type="text"
               id="edit_Province"
               name="Province"
               class="form-control"
               maxlength="100" />
    </div>

    <div class="col-md-4">
        <label for="edit_Country" class="form-label">
            País
        </label>

        <input type="text"
               id="edit_Country"
               name="Country"
               class="form-control"
               maxlength="100" />
    </div>

    <div class="col-12">
        <label for="edit_Notes" class="form-label">
            Observaciones
        </label>

        <textarea id="edit_Notes"
                  name="Notes"
                  class="form-control"
                  rows="4"
                  maxlength="500"></textarea>
    </div>

</div>