
@{
    ViewData["Title"] = "Panel Principal";
}

<div class="dashboard-header">
    <div class="dashboard-header-top">
        <h1 class="dashboard-title">Panel Principal</h1>
        <span class="dashboard-badge">Operador</span>
    </div>
</div>

<div class="dashboard-section">
    <div class="section-title">Inventario</div>

    <div class="dashboard-grid-section grid-one-col">
        <a asp-controller="Stocks"
           asp-action="Index"
           class="dashboard-card dashboard-card-featured text-decoration-none">

            <div class="dashboard-card-icon-wrap dashboard-card-icon-wrap-featured">
                <i class="bi bi-box-seam dashboard-card-icon dashboard-card-icon-featured"></i>
            </div>

            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title dashboard-card-title-featured">
                    Existencias y Transferencias
                </h4>
                <p class="dashboard-card-desc">
                    Consultar el stock disponible y transferir artículos entre depósitos
                </p>
            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow dashboard-card-arrow-featured"></i>
        </a>
    </div>
</div>

<div class="dashboard-section">
    <div class="section-title">Compras</div>

    <div class="dashboard-grid-section grid-one-col">

        <a asp-controller="PurchaseOrders"
           asp-action="Index"
           class="dashboard-card text-decoration-none">

            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-cart-check dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title">Órdenes de Compra</h4>
                <p class="dashboard-card-desc">
                    Consultar órdenes de compra y gestionar la recepción de mercadería
                </p>
            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>

        <a asp-controller="Receipts"
           asp-action="Index"
           class="dashboard-card text-decoration-none">

            <div class="dashboard-card-icon-wrap">
                <i class="bi bi-clipboard-check dashboard-card-icon"></i>
            </div>

            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title">Historial de Recepciones</h4>
                <p class="dashboard-card-desc">
                    Consultar las recepciones de mercadería registradas desde órdenes de compra
                </p>
            </div>

            <i class="bi bi-chevron-right dashboard-card-arrow"></i>
        </a>

    </div>
</div>
