@model IEnumerable<TransformadoresApp.Models.Inventory.Warehouse>

@{
    ViewData["Title"] = "Depósitos";
}

<a asp-controller="Home" asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i>
    Panel Principal
</a>

<div class="page-card">
    <h2 class="page-card-title">
        <i class="bi bi-buildings"></i>
        Depósitos
    </h2>

    <div class="view-actions">
        <button class="btn-create" onclick="openCreateModal()">
            <i class="bi bi-plus-circle"></i>
            Nuevo Depósito
        </button>

        <a asp-action="Index" asp-route-showInactive="@(!(ViewBag.ShowInactive ?? false))" class="btn btn-outline-secondary">
            <i class="bi bi-eye"></i>
            @(ViewBag.ShowInactive == true
                ? "Ocultar inactivos"
                : "Mostrar inactivos")
        </a>
    </div>

    <table class="table table-hover mt-3">
        <thead>
            <tr>
                <th style="width:20%">
                    Código
                </th>

                <th style="width:50%">
                    Nombre
                </th>

                <th style="width:15%" class="text-center">
                    Estado
                </th>

                <th style="width:15%" class="text-center">
                    Acciones
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model) {
                var warehouseData = new
                {
                    id = item.Id,
                    code = item.Code,
                    name = item.Name,
                    description = item.Description
                };

                <tr>
                    <td style="vertical-align:middle">
                        @item.Code
                    </td>

                    <td style="vertical-align:middle">
                        @item.Name
                    </td>

                    <td class="text-center"
                        style="vertical-align:middle">

                        @if (item.IsActive) {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else {
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        <div class="action-btn-group">
                            @if (item.IsActive) {
                                <button class="action-btn action-btn-edit" onclick='openEditModal(@Html.Raw(Json.Serialize(warehouseData)))'>
                                    <i class="bi bi-pencil"></i>
                                    <span class="action-tooltip">
                                        Modificar
                                    </span>
                                </button>

                                <button class="action-btn action-btn-delete" onclick='openDeactivateModal(@Html.Raw(Json.Serialize(warehouseData)))'>
                                    <i class="bi bi-pause-circle"></i>
                                    <span class="action-tooltip">
                                        Desactivar
                                    </span>
                                </button>
                            }
                            else {
                                <button class="action-btn action-btn-restore" onclick='openRestoreModal(@Html.Raw(Json.Serialize(warehouseData)))'>
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <span class="action-tooltip">
                                        Restaurar
                                    </span>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Modals/_CreateWarehouseModal" />
<partial name="_Modals/_EditWarehouseModal" />
<partial name="_Modals/_DeactivateWarehouseModal" />
<partial name="_Modals/_RestoreWarehouseModal" />

@section Scripts{
    <script src="~/js/warehouses.modals.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}