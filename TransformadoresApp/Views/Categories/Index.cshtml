@model IEnumerable<TransformadoresApp.Models.Catalogs.Category>

@{
    ViewData["Title"] = "Categorías";
}

<a asp-controller="Home"
   asp-action="Index"
   class="page-back">
    <i class="bi bi-arrow-left"></i>
    Panel Principal
</a>

<div class="page-card">

    <h2 class="page-card-title">
        <i class="bi bi-tags"></i>
        Categorías
    </h2>

    <div class="view-actions">
        <button class="btn-create"
                onclick="openCreateModal()">

            <i class="bi bi-plus-circle"></i>
            Nueva Categoría

        </button>
    </div>

    <form method="get" class="mt-3 mb-3">
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   name="showInactive"
                   value="true"
                   id="showInactive"
                   @(ViewBag.ShowInactive ? "checked" : null)
                   onchange="this.form.submit()" />
            <label class="form-check-label"
                   for="showInactive">
                Mostrar categorías inactivas
            </label>
        </div>
    </form>

    <table class="table table-hover mt-2">

        <thead>
            <tr>
                <th class="text-center">
                    Nombre
                </th>

                <th class="text-center">
                    Categoría padre
                </th>

                <th class="text-center">
                    Estado
                </th>

                <th></th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                var categoryData = new
                {
                    id = item.Id,
                    name = item.Name,
                    parentId = item.ParentId
                };

                <tr>

                    <td class="text-center"
                        style="align-content:center">

                        @item.Name

                    </td>

                    <td class="text-center"
                        style="align-content:center">

                        @(item.Parent?.Name ?? "-")

                    </td>

                    <td class="text-center" style="align-content:center">
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">
                                Activa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactiva
                            </span>
                        }
                    </td>

                    <td>

                        <div class="action-btn-group">

                            @if (item.IsActive)
                            {
                                <button class="action-btn action-btn-edit"
                                        onclick='openEditModal(@Html.Raw(Json.Serialize(categoryData)))'>

                                    <i class="bi bi-pencil"></i>

                                    <span class="action-tooltip">
                                        Modificar
                                    </span>

                                </button>

                                <button class="action-btn action-btn-delete"
                                        onclick='openDeleteModal(
                                            @item.Id,
                                            "@item.Name",
                                            "@(item.Parent?.Name ?? "")")'>

                                    <i class="bi bi-slash-circle"></i>

                                    <span class="action-tooltip">
                                        Desactivar
                                    </span>

                                </button>
                            }
                            else
                            {
                                <form asp-action="Reactivate"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="action-btn action-btn-edit">

                                        <i class="bi bi-arrow-clockwise"></i>

                                        <span class="action-tooltip">
                                            Reactivar
                                        </span>

                                    </button>

                                </form>
                            }
                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<partial name="_Modals/_CreateCategoryModal" />
<partial name="_Modals/_EditCategoryModal" />
<partial name="_Modals/_DeleteCategoryModal" />

@section Scripts {

    <script src="~/js/categories.modals.js"
            asp-append-version="true"></script>

    <partial name="_ValidationScriptsPartial" />

}
