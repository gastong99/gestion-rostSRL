@model IEnumerable<TransformadoresApp.Models.Purchasing.Supplier>

@{
    ViewData["Title"] = "Proveedores";
}

<a asp-controller="Home" asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i>
    Panel Principal
</a>

<div class="page-card">
    <h2 class="page-card-title">
        <i class="bi bi-truck"></i>
        Proveedores
    </h2>

    <div class="view-actions">
        <button class="btn-create" onclick="openCreateModal()">
            <i class="bi bi-plus-circle"></i>
            Nuevo Proveedor
        </button>

        <a asp-action="Index" asp-route-showInactive="@(!(ViewBag.ShowInactive ?? false))" class="btn btn-outline-secondary">
            <i class="bi bi-eye"></i>
            @(ViewBag.ShowInactive == true
                ? "Ocultar inactivos"
                : "Mostrar inactivos")
        </a>
    </div>

    <table class="table table-hover mt-3">
        <thead>
            <tr>
                <th style="width:10%">
                    Código
                </th>

                <th style="width:24%">
                    Razón Social
                </th>

                <th style="width:16%">
                    Nombre Comercial
                </th>

                <th style="width:12%">
                    CUIT
                </th>

                <th style="width:12%">
                    Teléfono
                </th>

                <th style="width:11%">
                    Ciudad
                </th>

                <th style="width:7%" class="text-center">
                    Estado
                </th>

                <th style="width:8%" class="text-center">
                    Acciones
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model) {
                var supplierData = new
                {
                    id = item.Id,
                    code = item.Code,
                    businessName = item.BusinessName,
                    fantasyName = item.FantasyName,
                    taxId = item.TaxId,
                    email = item.Email,
                    phone = item.Phone,
                    address = item.Address,
                    city = item.City,
                    province = item.Province,
                    country = item.Country,
                    notes = item.Notes
                };

                <tr>
                    <td style="vertical-align:middle">
                        @item.Code
                    </td>

                    <td style="vertical-align:middle">
                        @item.BusinessName
                    </td>

                    <td style="vertical-align:middle">
                        @item.FantasyName
                    </td>

                    <td style="vertical-align:middle">
                        @item.TaxId
                    </td>

                    <td style="vertical-align:middle">
                        @item.Phone
                    </td>

                    <td style="vertical-align:middle">
                        @item.City
                    </td>

                    <td class="text-center"
                        style="vertical-align:middle">

                        @if (item.IsActive) {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else {
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        <div class="action-btn-group">
                            @if (item.IsActive) {
                                <button class="action-btn action-btn-edit" onclick='openEditModal(@Html.Raw(Json.Serialize(supplierData)))'>
                                    <i class="bi bi-pencil"></i>
                                    <span class="action-tooltip">
                                        Modificar
                                    </span>
                                </button>

                                <button class="action-btn action-btn-delete" onclick='openDeactivateModal(@Html.Raw(Json.Serialize(supplierData)))'>
                                    <i class="bi bi-pause-circle"></i>
                                    <span class="action-tooltip">
                                        Desactivar
                                    </span>
                                </button>
                            }
                            else {
                                <button class="action-btn action-btn-restore" onclick='openRestoreModal(@Html.Raw(Json.Serialize(supplierData)))'>
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <span class="action-tooltip">
                                        Restaurar
                                    </span>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Modals/_CreateSupplierModal" />
<partial name="_Modals/_EditSupplierModal" />
<partial name="_Modals/_DeactivateSupplierModal" />
<partial name="_Modals/_RestoreSupplierModal" />

@section Scripts {
    <script src="~/js/suppliers.modals.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}