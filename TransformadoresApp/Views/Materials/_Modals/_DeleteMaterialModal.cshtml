<div class="modal fade" id="deleteMaterialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="deleteMaterialError" class="alert alert-danger d-none mb-3">
                    <i class="bi bi-x-octagon-fill"></i>
                    <strong>No se puede eliminar.</strong>
                    <p class="mb-0 mt-2">Este material se utiliza en los siguientes transformadores:</p>
                    <ul id="deleteMaterialUsedIn" class="mb-0 mt-2"></ul>
                </div>

                <div id="deleteMaterialConfirm">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>¿Está seguro que desea eliminar este material?</strong>
                        <p class="mb-0 mt-2 text-muted">Esta acción no se puede deshacer.</p>
                    </div>

                    <table class="table table-bordered table-sm">
                        <tbody>
                            <tr><th style="width: 40%;">Código</th><td id="deleteMaterialCode"></td></tr>
                            <tr><th>Nombre</th><td id="deleteMaterialName"></td></tr>
                            <tr><th>Unidad de medida</th><td id="deleteMaterialUnit"></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteMaterialForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span id="deleteMaterialCancelText">Cancelar</span>
                    </button>
                    <button type="submit" class="btn btn-danger" id="deleteMaterialSubmit">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
