@model TransformadoresApp.Models.Catalogs.Category

<div class="row g-3">

    <div class="col-md-6">
        <label for="create_Name" class="form-label">
            Nombre <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="create_Name"
               name="Name"
               class="form-control"
               maxlength="100"
               required />

        <span class="text-danger"
              data-valmsg-for="Name"></span>
    </div>

    <div class="col-md-6">
        <label for="create_ItemType" class="form-label">
            Tipo <span class="text-danger">*</span>
        </label>

        <select id="create_ItemType"
                name="ItemType"
                class="form-select"
                required>

            <option value="">
                Seleccionar...
            </option>

        </select>

        <span class="text-danger"
              data-valmsg-for="ItemType"></span>
    </div>

    <div class="col-12">

        <label for="create_ParentId" class="form-label">

            Categoría padre

        </label>

        <select id="create_ParentId"
                name="ParentId"
                class="form-select">

            <option value="">
                Sin categoría padre
            </option>

        </select>

    </div>

</div>