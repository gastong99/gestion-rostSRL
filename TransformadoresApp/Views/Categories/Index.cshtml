@model IEnumerable<TransformadoresApp.Models.Catalogs.Category>
@using TransformadoresApp.Models.Catalogs

@{
    ViewData["Title"] = "Categorías";
}

<a asp-controller="Home" asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i>
    Panel Principal
</a>

<div class="page-card">

    <h2 class="page-card-title">
        <i class="bi bi-diagram-3"></i>
        Categorías
    </h2>

    <div class="view-actions">

        <button class="btn-create" onclick="openCreateModal()">
            <i class="bi bi-plus-circle"></i>
            Nueva Categoría
        </button>

        <a asp-action="Index" asp-route-showInactive="@(!(ViewBag.ShowInactive ?? false))" class="btn btn-outline-secondary">
            <i class="bi bi-eye"></i>

            @(ViewBag.ShowInactive == true
                ? "Ocultar inactivas"
                : "Mostrar inactivas")
        </a>

    </div>

    <table class="table table-hover mt-3">

        <thead>

            <tr>
                <th style="width:30%">
                    Nombre
                </th>

                <th style="width:20%">
                    Tipo
                </th>

                <th style="width:25%">
                    Categoría padre
                </th>

                <th style="width:10%" class="text-center">
                    Estado
                </th>

                <th style="width:15%" class="text-center">
                    Acciones
                </th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model) {
                var categoryData = new
                {
                    id = item.Id,
                    name = item.Name,
                    parentId = item.ParentId,
                    itemType = item.ItemType
                };

                <tr>

                    <td style="vertical-align:middle">
                        @item.Name
                    </td>

                    <td style="vertical-align:middle">

                        @switch (item.ItemType)
                        {
                            case ItemType.RawMaterial:

                                <span class="badge bg-success">
                                    Materia Prima
                                </span>

                                break;

                            case ItemType.FinishedProduct:

                                <span class="badge bg-primary">
                                    Producto Terminado
                                </span>

                                break;

                            case ItemType.CommercialProduct:

                                <span class="badge bg-info text-dark">
                                    Producto Comercial
                                </span>

                                break;

                            case ItemType.Service:

                                <span class="badge bg-warning text-dark">
                                    Servicio
                                </span>

                                break;

                            default:

                                <span class="badge bg-secondary">
                                    Sin definir
                                </span>

                                break;
                        }

                    </td>

                    <td style="vertical-align:middle">

                        @(item.Parent?.Name ?? "-")

                    </td>

                    <td class="text-center"
                        style="vertical-align:middle">

                        @if (item.IsActive) {
                            <span class="badge bg-success">
                                Activa
                            </span>
                        }
                        else {
                            <span class="badge bg-secondary">
                                Inactiva
                            </span>
                        }

                    </td>

                    <td>

                        <div class="action-btn-group">

                            @if (item.IsActive) {
                                <button class="action-btn action-btn-edit" onclick='openEditModal(@Html.Raw(Json.Serialize(categoryData)))'>
                                    <i class="bi bi-pencil"></i>
                                    <span class="action-tooltip">
                                        Modificar
                                    </span>
                                </button>

                                <button class="action-btn action-btn-delete" onclick='openDeleteModal(@item.Id, "@item.Name", "@(item.Parent?.Name ?? "")")'>
                                    <i class="bi bi-trash"></i>
                                    <span class="action-tooltip">
                                        Desactivar
                                    </span>
                                </button>
                            }
                            else {
                                <button class="action-btn action-btn-restore" onclick='openRestoreModal(@item.Id, "@item.Name")'>
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <span class="action-tooltip">
                                        Restaurar
                                    </span>
                                </button>
                            }
                        </div>

                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Modals/_CreateCategoryModal" />
<partial name="_Modals/_EditCategoryModal" />
<partial name="_Modals/_DeleteCategoryModal" />
<partial name="_Modals/_RestoreCategoryModal" />

@section Scripts{

    <script src="~/js/categories.modals.js"
            asp-append-version="true"></script>

    <partial name="_ValidationScriptsPartial"/>

}