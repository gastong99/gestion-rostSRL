
<div class="modal fade" id="deactivateCustomerModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">
                    <i class="bi bi-pause-circle"></i>
                    Desactivar Cliente
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="alert alert-warning">
                    ¿Desea desactivar este cliente?
                </div>

                <table class="table table-bordered">

                    <tbody>

                        <tr>
                            <th>Código</th>
                            <td id="deactivateCustomerCode"></td>
                        </tr>

                        <tr>
                            <th>Cliente</th>
                            <td id="deactivateCustomerName"></td>
                        </tr>

                        <tr>
                            <th>CUIT / Documento</th>
                            <td id="deactivateCustomerIdentification"></td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="modal-footer">

                <form id="deactivateCustomerForm" method="post">

                    @Html.AntiForgeryToken()

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-danger">

                        <i class="bi bi-pause-circle"></i>
                        Desactivar

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>