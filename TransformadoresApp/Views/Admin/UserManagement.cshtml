
@model TransformadoresApp.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<a asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i> Volver
</a>

<div class="page-card">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <h2 class="page-card-title mb-0">
            <i class="bi bi-people"></i> Gestión de Usuarios
        </h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-person-plus"></i> Nuevo usuario
        </button>
    </div>

    @if (!Model.Users.Any())
    {
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No hay usuarios registrados.
        

        </div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th class="text-center">Rol actual</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model.Users)
                {
                    var isAdmin = user.Roles.Contains("Administrador");
                    var isOperator = user.Roles.Contains("Operador");

                    <tr>
                        <td>
                            @user.Email

                        </td>

                        <td class="text-center">
                            @if (isAdmin)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-person-fill-gear"></i>
                                    Administrador
                                </span>
                            }
                            else if (isOperator)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-person-fill"></i>
                                    Operador
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-person"></i>
                                    Sin rol
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            @if (isAdmin)
                            {
                                <span class="text-muted small">
                                    <i class="bi bi-shield-fill-check"></i>
                                    Administrador completo
                                </span>
                            }
                            else
                            {
                                @if (isOperator)
                                {
                                    <form asp-action="RemoveFromRole"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="userId"
                                               value="@user.UserId" />

                                        <input type="hidden"
                                               name="role"
                                               value="Operador" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Quitar el rol de Operador a este usuario?')">
                                            <i class="bi bi-person-dash"></i>
                                            Quitar Operador
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="AddToRole"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="userId"
                                               value="@user.UserId" />

                                        <input type="hidden"
                                               name="role"
                                               value="Operador" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('¿Asignar el rol de Operador a este usuario?')">
                                            <i class="bi bi-person-plus"></i>
                                            Asignar Operador
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-page="@(Model.CurrentPage - 1)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-route-page="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-page="@(Model.CurrentPage + 1)">
                            Siguiente
                        </a>
                    </li>

                </ul>
            </nav>
        }
    }
</div>

<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createUserModalLabel">Crear usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newUserEmail" class="form-label">Correo electrónico *</label>
                        <input id="newUserEmail" name="Email" type="email" class="form-control" maxlength="256" autocomplete="off" required />
                    </div>
                    <div class="mb-3">
                        <label for="newUserPassword" class="form-label">Contraseña temporal *</label>
                        <input id="newUserPassword" name="Password" type="password" class="form-control" minlength="12" maxlength="100" autocomplete="new-password" required />
                        <div class="form-text">Mínimo 12 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                    </div>
                    <div class="mb-3">
                        <label for="newUserRole" class="form-label">Rol *</label>
                        <select id="newUserRole" name="Role" class="form-select" required>
                            <option value="Operador">Operador</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus"></i> Crear usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>
