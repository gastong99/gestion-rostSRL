@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro deshabilitado";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header text-center">
                <h4 class="my-2"><i class="bi bi-person-lock"></i> Registro deshabilitado</h4>
            </div>
            <div class="card-body text-center">
                <p class="mb-4">
                    La creación de cuentas está deshabilitada. Para solicitar un usuario,
                    comunicate con el Administrador del sistema.
                </p>
                <a asp-page="./Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Ir al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</div>