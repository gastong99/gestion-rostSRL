@model TransformadoresApp.Models.Inventory.ItemStock

<div class="row g-3">

    <input type="hidden"
           id="edit_Id"
           name="Id" />

    <div class="col-md-6">
        <label for="edit_ItemId" class="form-label">
            Item <span class="text-danger">*</span>
        </label>

        <select id="edit_ItemId"
                name="ItemId"
                class="form-select"
                required>
            <option value="">
                Seleccione un item...
            </option>
        </select>
    </div>

    <div class="col-md-6">
        <label for="edit_WarehouseId" class="form-label">
            Depósito <span class="text-danger">*</span>
        </label>

        <select id="edit_WarehouseId"
                name="WarehouseId"
                class="form-select"
                required>
            <option value="">
                Seleccione un depósito...
            </option>
        </select>
    </div>

    <div class="col-md-4">
        <label for="edit_CurrentQuantity" class="form-label">
            Stock actual <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="edit_CurrentQuantity"
               class="form-control"
               readonly />
    </div>

    <div class="col-md-4">

        <label class="form-label">
            Ajuste <span class="text-danger">*</span>
        </label>

        <input type="number"
               id="edit_Adjustment"
               name="adjustment"
               class="form-control"
               step="0.01"
               required />
    </div>

    <div class="col-md-4">
        <label class="form-label">
            Reservado
        </label>

        <input type="text"
               id="edit_ReservedQuantity"
               class="form-control"
               value="0.00"
               readonly />
    </div>

    <div class="col-md-4">
        <label class="form-label">
            Nuevo Stock
        </label>

        <input type="text"
               id="edit_NewQuantity"
               class="form-control"
               value="0.00"
               readonly />
    </div>

    <div class="col-12">

        <div id="edit_AdjustmentValidation" class="text-danger fw-semibold" style="display:none;">
            El ajuste dejaría el stock en una cantidad negativa.
        </div>

    </div>

</div>
