@model TransformadoresApp.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<a asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i> Volver
</a>

<div class="page-card">
    <h2 class="page-card-title">
        <i class="bi bi-people"></i> Gestión de Usuarios
    </h2>

    @if (!Model.Users.Any()) {
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-triangle-fill"></i> No hay usuarios registrados.
        </div>
    }
    else {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th class="text-center">Rol Actual</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users) {
                    var isAdmin = user.Roles.Contains("Administrador");
                    var isOperario = user.Roles.Contains("Operario");
                    var isMainAdmin = user.Email == "admin@rostagno.com";
                    <tr>
                        <td>
                            @user.Email
                            @if (isMainAdmin) {
                                <span class="badge bg-primary ms-2">
                                    <i class="bi bi-shield-fill"></i> Principal
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (isAdmin) {
                                <span class="badge bg-danger">
                                    <i class="bi bi-person-fill-gear"></i> Administrador
                                </span>
                            }
                            else if (isOperario) {
                                <span class="badge bg-success">
                                    <i class="bi bi-person-fill"></i> Operario
                                </span>
                            }
                            else {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-person"></i> Sin rol
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (isAdmin) {
                                @if (!isMainAdmin) {
                                    <span class="text-muted small">
                                        <i class="bi bi-lock-fill"></i> Administrador completo
                                    </span>
                                }
                                else {
                                    <span class="text-muted small">
                                        <i class="bi bi-shield-fill-check"></i> Usuario protegido
                                    </span>
                                }
                            }
                            else {
                                @if (isOperario) {
                                    <form asp-action="RemoveFromRole" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <input type="hidden" name="role" value="Operario" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Quitar rol de Operario a este usuario?')">
                                            <i class="bi bi-person-dash"></i> Quitar Operario
                                        </button>
                                    </form>
                                }
                                else {
                                    <form asp-action="AddToRole" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <input type="hidden" name="role" value="Operario" />
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('¿Asignar rol de Operario a este usuario?')">
                                            <i class="bi bi-person-plus"></i> Asignar Operario
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1) {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)">Anterior</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++) {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>