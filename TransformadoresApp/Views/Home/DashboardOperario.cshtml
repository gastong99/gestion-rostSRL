@{
    ViewData["Title"] = "Panel Principal";
}

<div class="dashboard-header">
    <div class="dashboard-header-top">
        <h1 class="dashboard-title">Panel Principal</h1>
        <span class="dashboard-badge">Operario</span>
    </div>
</div>

<div class="dashboard-section">
    <div class="section-title">Producción</div>
    <div class="dashboard-grid-section grid-one-col">
        <a asp-controller="ProductionOrders" asp-action="Index" class="dashboard-card dashboard-card-featured text-decoration-none">
            <div class="dashboard-card-icon-wrap dashboard-card-icon-wrap-featured">
                <i class="bi bi-list-check dashboard-card-icon dashboard-card-icon-featured"></i>
            </div>
            <div class="dashboard-card-body">
                <h4 class="dashboard-card-title dashboard-card-title-featured">Órdenes de Producción</h4>
                <p class="dashboard-card-desc">Gestionar y crear órdenes de fabricación</p>
            </div>
            <i class="bi bi-chevron-right dashboard-card-arrow dashboard-card-arrow-featured"></i>
        </a>
    </div>
</div>