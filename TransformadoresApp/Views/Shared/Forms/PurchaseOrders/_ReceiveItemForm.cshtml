<div class="row g-3">

    <div class="col-md-8">

        <label class="form-label">
            Item
        </label>

        <input type="text"
               id="receive_ItemName"
               class="form-control"
               readonly />

    </div>

    <div class="col-md-4">

        <label class="form-label">
            Depósito
        </label>

        <select id="receive_WarehouseId"
                name="WarehouseId"
                class="form-select"
                asp-items="ViewBag.Warehouses"
                required>

            <option value="">
                -- Seleccione --
            </option>

        </select>

    </div>

    <div class="col-md-4">

        <label class="form-label">
            Cantidad Pedida
        </label>

        <input type="text"
               id="receive_OrderedQuantity"
               class="form-control"
               readonly />

    </div>

    <div class="col-md-4">

        <label class="form-label">
            Ya Recibida
        </label>

        <input type="text"
               id="receive_ReceivedQuantity"
               class="form-control"
               readonly />

    </div>

    <div class="col-md-4">

        <label class="form-label">
            Pendiente
        </label>

        <input type="text"
               id="receive_PendingQuantity"
               class="form-control"
               readonly />

    </div>

    <div class="col-md-12">

        <label class="form-label">

            Cantidad a recibir

            <span class="text-danger">*</span>

        </label>

        <input type="number"
               id="receive_Quantity"
               name="Quantity"
               class="form-control"
               min="0.01"
               step="0.01"
               required />

    </div>

</div>