<div class="modal fade" id="createBomItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #1E6B45; color: #fff;">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle"></i> <span id="createBomModalTitle">Agregar material de fabricación</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createBomItemForm" asp-controller="BomItems" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <partial name="Forms/BomItems/_CreateForm" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-success" style="background: #1E6B45; color: #fff;">
                        <i class="bi bi-save"></i> Agregar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>