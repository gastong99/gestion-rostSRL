@model TransformadoresApp.Models.Product
@{
    ViewData["Title"] = "Detalles del Transformador";
}

<a asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i> Volver a Transformadores
</a>

<div class="page-card">
    <h2 class="page-card-title">
        <i class="bi bi-file-text"></i> Detalles del Transformador
    </h2>

    <div class="table-responsive mb-4">
        <table class="table table-bordered">
            <tbody>
                <tr><th>Código</th><td>@Model.Code</td></tr>
                <tr><th>Nombre</th><td>@Model.Name</td></tr>
                <tr><th>Potencia (kVA)</th><td>@Model.PotenciaKVA</td></tr>
                <tr><th>Pérdidas Po (W)</th><td>@Model.PerdidasPo</td></tr>
                <tr><th>Pérdidas Pcc (W)</th><td>@Model.PerdidasPcc</td></tr>
                <tr><th>Ucc (%)</th><td>@Model.Ucc</td></tr>
                <tr><th>Dimensiones</th><td>Largo: @Model.Largo — Ancho: @Model.Ancho — Alto: @Model.Alto</td></tr>
                <tr><th>Diámetro (mm)</th><td>@Model.Diametro</td></tr>
                <tr><th>Peso (Kg)</th><td>@Model.Peso</td></tr>
            </tbody>
        </table>
    </div>

    <h4 class="page-card-title" style="margin-top: 8px;">
        <i class="bi bi-gear"></i> Materiales de fabricación (BOM)
    </h4>

    @if (Model.BomItems != null && Model.BomItems.Any())
    {
        <div class="table-responsive mt-2 mb-4">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Material</th>
                        <th class="text-end">Cantidad</th>
                        <th>Unidad de medida</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BomItems)
                    {
                        var bomItemData = new
                        {
                            bomItemId = item.BomItemId,
                            productId = item.ProductId,
                            materialId = item.MaterialId,
                            quantityPerUnit = item.QuantityPerUnit,
                            material = new
                            {
                                materialId = item.Material?.MaterialId,
                                name = item.Material?.Name,
                                unitOfMeasure = new { name = item.Material?.UnitOfMeasure?.Name }
                            }
                        };
                        <tr>
                            <td>@item.Material?.Name</td>
                            <td class="text-end">@item.QuantityPerUnit</td>
                            <td>@item.Material?.UnitOfMeasure?.Abbreviation</td>
                            <td>
                                <div class="action-btn-group">
                                    <button class="action-btn action-btn-edit"
                                            onclick='openEditBomModal(@Html.Raw(Json.Serialize(bomItemData)))'>
                                        <i class="bi bi-pencil"></i>
                                        <span class="action-tooltip">Modificar</span>
                                    </button>
                                    <button class="action-btn action-btn-delete"
                                            onclick='openDeleteBomModal(@item.BomItemId, "@item.Material?.Name", @item.QuantityPerUnit?.ToString("0.##"), "@item.Material?.UnitOfMeasure?.Name")'>
                                        <i class="bi bi-trash"></i>
                                        <span class="action-tooltip">Eliminar</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-4" style="font-size:14px;">No hay materiales asociados.</p>
    }

    <div class="view-actions" style="margin-top: 8px;">
        <button class="btn-create" onclick="openCreateBomModal(@Model.ProductId, '@Model.Name')">
            <i class="bi bi-plus-circle"></i> Agregar Material
        </button>
    </div>
</div>

<partial name="../BomItems/_Modals/_CreateBomItemModal" />
<partial name="../BomItems/_Modals/_EditBomItemModal" />
<partial name="../BomItems/_Modals/_DeleteBomItemModal" />

@section Scripts {
    <script src="~/js/bomitems.modals.js"></script>
    <partial name="_ValidationScriptsPartial" />
}