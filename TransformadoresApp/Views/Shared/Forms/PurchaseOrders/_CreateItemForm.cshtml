<input type="hidden"
       id="create_PurchaseOrderId"
       name="PurchaseOrderId" />

<div class="row g-3">

    <div class="col-md-8">

        <label class="form-label">

            Item <span class="text-danger">*</span>

        </label>

        <select id="create_ItemId"
                name="ItemId"
                class="form-select"
                asp-items="ViewBag.Items"
                required>

            <option value="">

                -- Seleccione un item --

            </option>

        </select>

    </div>

    <div class="col-md-2">

        <label class="form-label">

            Cantidad

        </label>

        <input type="number"
               id="create_Quantity"
               name="Quantity"
               step="0.01"
               min="0.01"
               class="form-control"
               required />

    </div>

    <div class="col-md-2">

        <label class="form-label">

            Precio Unitario

        </label>

        <input type="number"
               id="create_UnitPrice"
               name="UnitPrice"
               step="0.01"
               min="0"
               class="form-control"
               required />

    </div>

    <div class="col-12">

        <label class="form-label">

            Subtotal

        </label>

        <input type="text"
               id="create_Subtotal"
               class="form-control"
               readonly />

    </div>

</div>
