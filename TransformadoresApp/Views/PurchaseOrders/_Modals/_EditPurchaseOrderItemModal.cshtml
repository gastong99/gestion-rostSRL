<div class="modal fade"
     id="editPurchaseOrderItemModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="bi bi-pencil"></i>
                    <span id="editPurchaseOrderItemModalTitle">
                        Editar Item
                    </span>
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal">
                </button>
            </div>

            <form id="editPurchaseOrderItemForm" asp-controller="PurchaseOrderItems" asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <partial name="~/Views/Shared/Forms/PurchaseOrders/_EditItemForm.cshtml" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i>
                        Guardar cambios
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>