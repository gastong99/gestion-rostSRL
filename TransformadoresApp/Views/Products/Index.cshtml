@model TransformadoresApp.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Transformadores";
    var searchQuery = Context.Request.Query["search"].ToString();
}

<a asp-controller="Home" asp-action="Index" class="page-back">
    <i class="bi bi-arrow-left"></i> Panel Principal
</a>

<div class="page-card">
    <h2 class="page-card-title">
        <i class="bi bi-lightning-charge"></i> Transformadores
    </h2>

    <div class="view-actions">
        <button class="btn-create" onclick="openCreateModal()">
            <i class="bi bi-plus-circle"></i> Nuevo Transformador
        </button>

        @if (User.IsInRole("Administrador"))
        {
            @using (Html.BeginForm("Import", "Products", FormMethod.Post, new { enctype = "multipart/form-data", id = "importForm" }))
            {
                <div class="file-input-wrap">
                    <label class="file-input-label">
                        <i class="bi bi-file-earmark-excel"></i>
                        <span id="fileName">Seleccionar Excel...</span>
                        <input type="file" name="file" accept=".xlsx" required
                               onchange="document.getElementById('fileName').textContent = this.files[0]?.name ?? 'Seleccionar Excel...'" />
                    </label>
                    <button type="submit" class="btn-import">
                        <i class="bi bi-upload"></i> Importar
                    </button>
                </div>
            }
        }
    </div>

    <form method="get">
        <div class="search-bar" style="justify-content: center;">
            <div class="search-input-wrap">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@searchQuery" placeholder="Buscar por código o nombre..." />
            </div>
            <button type="submit" class="btn-search">
                <i class="bi bi-search"></i> Buscar
            </button>
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <a asp-action="Index" class="btn-clear-search">
                    <i class="bi bi-x-circle"></i> Limpiar
                </a>
            }
        </div>
    </form>

    @if (!Model.Products.Any())
    {
        <div class="alert alert-warning text-center mt-3">
            <i class="bi bi-exclamation-triangle-fill"></i> No se encontraron transformadores con los criterios aplicados.
        </div>
    }
    else
    {
        <table class="table table-hover mt-2">
            <thead>
                <tr>
                    <th class="text-center">Código</th>
                    <th class="text-center">Nombre</th>
                    <th class="text-center">Potencia (kVA)</th>
                    <th class="text-center">Peso (Kg)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td class="text-center" style="align-content:center">@item.Code</td>
                        <td class="text-center" style="align-content:center">@item.Name</td>
                        <td class="text-center" style="align-content:center">@item.PotenciaKVA</td>
                        <td class="text-center" style="align-content:center">@item.Peso</td>
                        <td>
                            <div class="action-btn-group">
                                <button class="action-btn action-btn-edit"
                                        onclick='openEditModal(@Html.Raw(Json.Serialize(item)))'>
                                    <i class="bi bi-pencil"></i>
                                    <span class="action-tooltip">Modificar</span>
                                </button>
                                <a asp-action="Details" asp-route-id="@item.ProductId"
                                       class="action-btn action-btn-detail">
                                    <i class="bi bi-file-text"></i>
                                    <span class="action-tooltip">Detalles</span>
                                </a>
                                <button class="action-btn action-btn-delete"
                                        onclick="openDeleteModal(@item.ProductId, '@item.Name')">
                                    <i class="bi bi-trash"></i>
                                    <span class="action-tooltip">Eliminar</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@searchQuery">Anterior</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-route-page="@i" asp-route-search="@searchQuery">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@searchQuery">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<partial name="_Modals/_CreateProductModal" />
<partial name="_Modals/_EditProductModal" />
<partial name="_Modals/_DeleteProductModal" />

@section Scripts {
    <script src="~/js/products.modals.js"></script>
    <partial name="_ValidationScriptsPartial" />
}