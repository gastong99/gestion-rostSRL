<!-- Modal Restaurar -->
<div class="modal fade" id="restoreOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #1E6B45; color: #fff;">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-counterclockwise"></i> Restaurar Orden
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle-fill"></i>
                    <p class="mb-2"><strong>¿Está seguro que desea restaurar esta orden?</strong></p>
                    <p class="mb-0">
                        <strong>Orden #<span id="restore_OrderId"></span></strong> -
                        <span id="restore_ProductName"></span>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <form id="restoreOrderForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-success" style="background: #1E6B45; color: #fff;">
                        <i class="bi bi-arrow-counterclockwise"></i> Restaurar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Eliminar Definitivamente -->
<div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Eliminar Definitivamente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>¡ATENCIÓN! Esta acción no se puede deshacer.</strong>
                    <p class="mb-0 mt-2">¿Está seguro que desea eliminar definitivamente esta orden?</p>
                </div>

                <table class="table table-bordered table-sm">
                    <tbody>
                        <tr>
                            <th style="width: 40%;">Orden</th>
                            <td>#<span id="delete_OrderId"></span></td>
                        </tr>
                        <tr>
                            <th>Transformador</th>
                            <td id="delete_ProductName"></td>
                        </tr>
                        <tr>
                            <th>Cantidad</th>
                            <td id="delete_Quantity"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <form id="deleteOrderForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle"></i> Eliminar Definitivamente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mover a Papelera -->
<div class="modal fade" id="moveToTrashModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-trash"></i> Mover a Papelera
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-info-circle-fill"></i>
                    <p class="mb-2"><strong>¿Está seguro que desea mover esta orden a la papelera?</strong></p>
                    <p class="mb-0">
                        <strong>Orden #<span id="trash_OrderId"></span></strong> -
                        <span id="trash_ProductName"></span>
                    </p>
                    <p class="mb-0 mt-2 small text-muted">Podrá restaurarla más tarde desde la papelera.</p>
                </div>
            </div>
            <div class="modal-footer">
                <form id="moveToTrashForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-trash"></i> Mover a Papelera
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmar Cambio de Estado -->
<div class="modal fade" id="changeStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: #0099CC; color: #fff;">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-repeat"></i> Cambiar Estado
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle-fill"></i>
                    <p class="mb-2"><strong>¿Está seguro que desea cambiar el estado de esta orden?</strong></p>
                    <p class="mb-0">
                        <strong>Orden #<span id="status_OrderId"></span></strong> —
                        Nuevo estado: <strong><span id="status_NewStatus"></span></strong>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelStatusChange" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="confirmStatusChange" style="background:#0099CC; border:none;">
                    <i class="bi bi-check-circle"></i> Confirmar
                </button>
            </div>
        </div>
    </div>
</div>