@model TransformadoresApp.Models.Purchasing.Supplier

<div class="row g-3">

    <input type="hidden"
           asp-for="Id"
           id="edit_Id" />

    <div class="col-md-4">
        <label asp-for="Code" class="form-label">
            Código <span class="text-danger">*</span>
        </label>

        <input asp-for="Code"
               id="edit_Code"
               class="form-control"
               maxlength="20"
               required />

        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="BusinessName" class="form-label">
            Razón Social <span class="text-danger">*</span>
        </label>

        <input asp-for="BusinessName"
               id="edit_BusinessName"
               class="form-control"
               maxlength="150"
               required />

        <span asp-validation-for="BusinessName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FantasyName" class="form-label">
            Nombre Comercial
        </label>

        <input asp-for="FantasyName"
               id="edit_FantasyName"
               class="form-control"
               maxlength="150" />

        <span asp-validation-for="FantasyName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TaxId" class="form-label">
            CUIT / RUT / NIT
        </label>

        <input asp-for="TaxId"
               id="edit_TaxId"
               class="form-control"
               maxlength="20"
               title="Ingresá un CUIT, RUT o NIT con al menos un número. Se admiten letras, números, puntos, espacios y guiones." />

        <span asp-validation-for="TaxId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label">
            Email
        </label>

        <input asp-for="Email"
               id="edit_Email"
               type="email"
               class="form-control"
               maxlength="150" />

        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Phone" class="form-label">
            Teléfono
        </label>

        <input asp-for="Phone"
               id="edit_Phone"
               type="tel"
               class="form-control"
               maxlength="50"
               inputmode="tel"
               data-phone-input
               data-initial-country="ar"
               title="Admite números, +, espacios, guiones y paréntesis." />

        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Address" class="form-label">
            Dirección
        </label>

        <input asp-for="Address"
               id="edit_Address"
               class="form-control"
               maxlength="200"
               title="Ingresá una dirección con letras. Podés incluir números, espacios y caracteres habituales de un domicilio." />

        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="City" class="form-label">
            Ciudad
        </label>

        <input asp-for="City"
               id="edit_City"
               class="form-control"
               maxlength="100"
               title="Ingresá un nombre compuesto por letras. No se permiten números." />

        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Province" class="form-label">
            Provincia
        </label>

        <input asp-for="Province"
               id="edit_Province"
               class="form-control"
               maxlength="100"
               title="Ingresá un nombre compuesto por letras. No se permiten números." />

        <span asp-validation-for="Province" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Country" class="form-label">
            País
        </label>

        <input asp-for="Country"
               id="edit_Country"
               class="form-control"
               maxlength="100"
               title="Ingresá un nombre compuesto por letras. No se permiten números." />

        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label">
            Observaciones
        </label>

        <textarea asp-for="Notes"
                  id="edit_Notes"
                  class="form-control"
                  rows="4"
                  maxlength="500"></textarea>

        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

</div>